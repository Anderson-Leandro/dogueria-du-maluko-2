# URL base da API. Padrão: "/api" (o proxy do Vite repassa para http://localhost:3333).
# Só defina se a API estiver em outro endereço, ex.: https://api.exemplo.com/api
# VITE_API_URL=/api

# Destino do proxy do Vite em desenvolvimento (padrão http://localhost:3333)
# API_PROXY_TARGET=http://localhost:3333
