# Porta HTTP da API
PORT=3333
# Banco SQLite (caminho relativo a prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Segredo do JWT — troque por um valor longo e aleatório
JWT_SECRET="troque-este-segredo-por-um-valor-longo-e-aleatorio"
JWT_EXPIRES_IN="7d"
# Origens liberadas no CORS, separadas por vírgula: front web (Vite :5173) e app mobile no navegador (Expo web :8081).
# O app nativo (Android/iOS) não usa CORS.
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"
# Frete em centavos e valor mínimo (centavos) para frete grátis
DELIVERY_FEE_CENTS=700
FREE_DELIVERY_MIN_CENTS=6000
